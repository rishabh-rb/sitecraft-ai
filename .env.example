# ==========================================
# SiteCraft AI — Environment Configuration
# ==========================================

# Runtime & Server Ports
NODE_ENV=development
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
SITECRAFT_DATA_DIR=./.data

# 1. PostgreSQL Database (Prisma ORM)
# Required for persistent production storage. If offline/unconfigured, SiteCraft AI
# gracefully uses local resilient JSON storage in SITECRAFT_DATA_DIR.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sitecraft"
# auto uses encrypted WebSockets on port 443 for Neon, TCP for other PostgreSQL.
# Use tcp to explicitly keep a standard PostgreSQL connection.
DATABASE_TRANSPORT=auto

# 2. Authentication (NextAuth / Auth.js)
# Required for session management.
AUTH_SECRET="replace-with-a-random-32-character-secret"
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
NEXTAUTH_URL=http://localhost:3000
# Comma-separated allowlist for admin access. Assign additional users through the
# database role field after the first admin is provisioned.
ADMIN_EMAILS=admin@sitecraft.ai
ADMIN_PASSWORD="set-a-strong-bootstrap-password"

# Google OAuth (Optional)
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail SMTP (use a Google App Password, never your normal Gmail password)
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password

# 3. AI Providers Configuration
# Primary provider: OpenRouter, with Gemini fallback
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# Output ceiling. Code receives up to 8192; smaller stages use lower budgets.
OPENROUTER_MAX_TOKENS=8192
# Direct Gemini provider / fallback.
GEMINI_API_KEY=
# Optional pool of additional authorized Gemini keys, separated by commas or spaces.
GEMINI_API_KEYS=
# Fallback provider: OpenAI API
OPENAI_API_KEY=
# Optional fallback provider: Bynara Router (disabled by default)
BYNARA_ENABLED=false
BYNARA_API_KEY=
BYNARA_BASE_URL=https://router.bynara.id/v1
BYNARA_MODEL=laguna-s-2.1

# Central AI Parameters & Model Overrides
AI_MODEL=gemini-3.6-flash
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=8192

# Per-agent model specialization (optional)
PLANNER_MODEL=
UI_MODEL=
CONTENT_MODEL=
CODE_MODEL=
QA_MODEL=

# 4. Optional Integrations
# Unsplash API for contextual website photography (fallback to curated high-res photos)
UNSPLASH_ACCESS_KEY=

# Vercel Deployment API (Optional)
# Obtain from Vercel Account Settings > Tokens
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Netlify Deployment API (Optional)
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
